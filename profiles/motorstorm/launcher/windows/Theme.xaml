<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Arctic Edge palette: polar night, glacier blue, aurora, and MotorStorm's ember orange for actions. -->
    <Color x:Key="NightColor">#050C17</Color>
    <Color x:Key="DeepColor">#0A1D33</Color>
    <Color x:Key="GlacierColor">#14385A</Color>
    <Color x:Key="IceColor">#BFEFFF</Color>
    <Color x:Key="FrostColor">#5CD6FF</Color>
    <Color x:Key="AuroraColor">#3BF0C8</Color>
    <Color x:Key="VioletColor">#8C7BFF</Color>
    <Color x:Key="EmberColor">#FF6A1A</Color>
    <Color x:Key="EmberLightColor">#FFA142</Color>

    <SolidColorBrush x:Key="TextBrush" Color="#F2FAFF"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A3BDD2"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6F8FA8"/>
    <SolidColorBrush x:Key="IceBrush" Color="{StaticResource IceColor}"/>
    <SolidColorBrush x:Key="FrostBrush" Color="{StaticResource FrostColor}"/>
    <SolidColorBrush x:Key="AuroraBrush" Color="{StaticResource AuroraColor}"/>
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource EmberColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#4BE3A0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC15C"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B7A"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="GlassStrongBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#66061423"/>

    <LinearGradientBrush x:Key="EmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource EmberLightColor}" Offset="0"/>
        <GradientStop Color="{StaticResource EmberColor}" Offset="0.55"/>
        <GradientStop Color="#E8480C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IceEdgeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#70E9FBFF" Offset="0"/>
        <GradientStop Color="#185CD6FF" Offset="0.45"/>
        <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFont">Bahnschrift SemiBold Condensed, Bahnschrift, Segoe UI Black</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource FrostBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Frosted glass card -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource IceEdgeGradient}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <!-- Primary action: ember orange slab -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="Height" Value="54"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="glow" CornerRadius="14" Background="{StaticResource EmberGradient}" Opacity="0.45" Margin="6,10,6,-4">
                            <Border.Effect><BlurEffect Radius="18"/></Border.Effect>
                        </Border>
                        <Border x:Name="body" CornerRadius="14" Background="{StaticResource EmberGradient}">
                            <Border CornerRadius="14" BorderThickness="1" BorderBrush="#55FFFFFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="glow" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="body" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="glow" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary action: ice glass -->
    <Style x:Key="IceButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="body" CornerRadius="10" Background="{StaticResource GlassStrongBrush}"
                            BorderBrush="#3A5CD6FF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="body" Property="Background" Value="#2A5CD6FF"/>
                            <Setter TargetName="body" Property="BorderBrush" Value="{StaticResource FrostBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="body" Property="Background" Value="#405CD6FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="body" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource FrostBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="c" VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Opacity" Value="0.75"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#E0433F"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Frosted text field -->
    <Style x:Key="FrostBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource FrostBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource FrostBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="10" Background="{StaticResource FieldBrush}"
                            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                       IsHitTestVisible="False" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#555CD6FF"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource FrostBrush}"/>
                            <Setter TargetName="b" Property="Background" Value="#8A061423"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True"><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Host / Join segmented tabs -->
    <Style x:Key="SegmentTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="11" Background="Transparent" Height="42">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#405CD6FF" Offset="0"/>
                                        <GradientStop Color="#263BF0C8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Who's racing?" choice cards -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="12" Background="{StaticResource GlassBrush}" BorderThickness="1.5"
                            BorderBrush="{StaticResource GlassBorderBrush}" Padding="12,10">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#665CD6FF"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource FrostBrush}"/>
                            <Setter TargetName="b" Property="Background" Value="#225CD6FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="#26FFFFFF"
                                BorderBrush="#40FFFFFF" BorderThickness="1">
                            <Ellipse x:Name="knob" Width="14" Height="14" Fill="{StaticResource SubtleTextBrush}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource FrostBrush}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource FrostBrush}"/>
                            <Setter TargetName="knob" Property="Fill" Value="#06223A"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F00A1D33"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#555CD6FF"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="b" CornerRadius="10" Background="{StaticResource FieldBrush}"
                                            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" HorizontalAlignment="Right"
                                                   Margin="0,0,12,0" Foreground="{StaticResource SubtleTextBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#555CD6FF"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                          Margin="14,0,34,0" VerticalAlignment="Center" TextElement.FontSize="14"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="#F20A1D33" BorderBrush="#555CD6FF" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="240"><StackPanel IsItemsHost="True" Margin="4"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" CornerRadius="7" Padding="10,8" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#335CD6FF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
