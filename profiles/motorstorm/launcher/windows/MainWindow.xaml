<Window x:Class="MotorStormLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MotorStormLauncher"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="MotorStorm: Arctic Edge Launcher" Width="1160" Height="740" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#050C17" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- ============ Scenery: polar sky, aurora, ice ridges, snowfall ============ -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                    <GradientStop Color="#040A14" Offset="0"/>
                    <GradientStop Color="#081A2F" Offset="0.45"/>
                    <GradientStop Color="#0F2E4C" Offset="0.8"/>
                    <GradientStop Color="#1A4566" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="AuroraA" Width="900" Height="320" Canvas.Left="-120" Canvas.Top="-90" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#663BF0C8" Offset="0"/>
                        <GradientStop Color="#003BF0C8" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TransformGroup><RotateTransform Angle="-8"/><TranslateTransform x:Name="AuroraAMove"/></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AuroraB" Width="820" Height="300" Canvas.Left="460" Canvas.Top="-60" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#558C7BFF" Offset="0"/>
                        <GradientStop Color="#008C7BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TransformGroup><RotateTransform Angle="10"/><TranslateTransform x:Name="AuroraBMove"/></TransformGroup></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="700" Height="260" Canvas.Left="240" Canvas.Top="40" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#445CD6FF" Offset="0"/>
                        <GradientStop Color="#005CD6FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
        <!-- Ice ridges along the bottom (stretched to the window width) -->
        <Viewbox Stretch="Fill" VerticalAlignment="Bottom" Height="260" IsHitTestVisible="False">
            <Canvas Width="1200" Height="260">
                <Path Data="M0,170 L90,120 L150,150 L250,70 L330,135 L420,95 L520,150 L610,60 L700,130 L790,100 L880,150 L980,80 L1080,140 L1200,105 L1200,260 L0,260 Z" Opacity="0.55">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2B5F86" Offset="0"/>
                            <GradientStop Color="#0B2440" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="M250,70 L232,88 L248,84 L262,96 L276,90 L290,102 Z M610,60 L590,82 L606,78 L618,92 L634,84 L650,96 Z M980,80 L962,98 L978,95 L990,106 L1006,100 L1020,110 Z"
                      Fill="#55E9FBFF"/>
                <Path Data="M0,215 L120,175 L210,200 L320,160 L430,205 L540,170 L660,210 L770,165 L880,200 L1000,170 L1110,205 L1200,185 L1200,260 L0,260 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A7AA6" Offset="0"/>
                            <GradientStop Color="#0A1F38" Offset="0.7"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="M0,240 L180,225 L360,238 L540,222 L720,240 L900,226 L1080,238 L1200,230 L1200,260 L0,260 Z" Fill="#C8E9F7FF" Opacity="0.08"/>
            </Canvas>
        </Viewbox>
        <local:SnowField x:Name="Snow"/>
        <!-- vignette -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusX="0.75" RadiusY="0.8" Center="0.5,0.45" GradientOrigin="0.5,0.45">
                    <GradientStop Color="#00000000" Offset="0.6"/>
                    <GradientStop Color="#99020610" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ Content ============ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <DockPanel Margin="18,0,8,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M8,0 L8,16 M1,4 L15,12 M1,12 L15,4 M8,0 L6,2 M8,0 L10,2 M8,16 L6,14 M8,16 L10,14"
                          Stroke="{StaticResource FrostBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Margin="0,0,10,0"/>
                    <TextBlock Text="ARCTIC EDGE  ·  LAUNCHER" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="44,6,40,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Left: brand + solo ============ -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0">
                        <TextBlock Text="PSP · PRIVATE RACES · WINDOWS ⇄ ANDROID" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                   Foreground="{StaticResource AuroraBrush}"/>
                        <TextBlock Text="MOTORSTORM" FontFamily="{StaticResource DisplayFont}" FontSize="58" Margin="-3,4,0,-12"
                                   Foreground="White">
                            <TextBlock.Effect><DropShadowEffect Color="#5CD6FF" BlurRadius="28" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="ARCTIC EDGE" FontFamily="{StaticResource DisplayFont}" FontSize="46" Margin="-2,0,0,0">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E9FBFF" Offset="0"/>
                                    <GradientStop Color="#7FE3FF" Offset="0.5"/>
                                    <GradientStop Color="#3BA9E0" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <Rectangle Height="3" Width="120" HorizontalAlignment="Left" Margin="0,8,0,14" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource EmberGradient}"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="14" LineHeight="21" MaxWidth="400" HorizontalAlignment="Left"
                                   Text="Host a room, send friends one join code, and race in the game's own Ad-hoc mode from another PC or an Android phone. Encrypted with the code."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="SettingsButton" Style="{StaticResource LinkButton}" Content="Game ISO · EBOOT · Texture pack · Settings…"
                                Click="Settings_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <!-- Game location -->
                        <Border Style="{StaticResource GlassCard}" CornerRadius="14" Padding="16,12" Margin="0,0,0,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Change…" Click="BrowseGame_Click"
                                        VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Ellipse x:Name="GameDot" Width="9" Height="9" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="GameTitle" Text="Game ready" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock x:Name="GamePathText" Text="" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DRIVER NAME" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="NicknameBox" Style="{StaticResource FrostBox}" Tag="Shown to other players" MaxLength="24"
                                         TextChanged="Nickname_Changed"/>
                            </StackPanel>
                            <CheckBox x:Name="FullscreenSwitch" Grid.Column="1" Style="{StaticResource Switch}" Content="Fullscreen"
                                      VerticalAlignment="Bottom" Margin="18,0,0,10" Click="Fullscreen_Click"/>
                        </Grid>
                        <Button x:Name="SoloButton" Style="{StaticResource IceButton}" Height="50" Click="Solo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="PLAY SOLO" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Normal"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- How to race -->
                    <StackPanel VerticalAlignment="Center" Margin="0,22,0,14">
                        <TextBlock Text="HOW TO RACE" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                        <ItemsControl>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" BorderThickness="1"
                                                BorderBrush="#775CD6FF" Background="#1A5CD6FF" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding [0]}" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                                       Foreground="{StaticResource FrostBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [1]}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{Binding [2]}" Style="{StaticResource Hint}" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsSource><x:Array Type="sys:Object">
                                <x:Array Type="sys:String"><sys:String>1</sys:String><sys:String>Host a room</sys:String><sys:String>Pick who's racing, then Start Hosting. The join code is copied for you.</sys:String></x:Array>
                                <x:Array Type="sys:String"><sys:String>2</sys:String><sys:String>Friends paste the code</sys:String><sys:String>Windows: this launcher › Join. Android: Multiplayer › Paste join code.</sys:String></x:Array>
                                <x:Array Type="sys:String"><sys:String>3</sys:String><sys:String>Meet in Ad-hoc</sys:String><sys:String>Wreckreation › Multiplayer › Ad-hoc › Create Game (host) or Join Game.</sys:String></x:Array>
                            </x:Array></ItemsControl.ItemsSource>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>

                <!-- ============ Right: multiplayer card ============ -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="26,22,26,20">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.45"/></Border.Effect>
                    <DockPanel>
                        <!-- Tabs -->
                        <Border DockPanel.Dock="Top" CornerRadius="13" Background="#40020A14" Padding="4" Margin="0,0,0,20">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="HostTab" Style="{StaticResource SegmentTab}" GroupName="tabs" IsChecked="True" Checked="Tab_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0"/>
                                        <TextBlock Text="HOST A RACE"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="JoinTab" Style="{StaticResource SegmentTab}" GroupName="tabs" Checked="Tab_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FA;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0"/>
                                        <TextBlock Text="JOIN A RACE"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Border>

                        <!-- Session strip -->
                        <Border DockPanel.Dock="Bottom" x:Name="SessionStrip" CornerRadius="12" Background="#33020A14" Padding="14,10" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="StopButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Stop game"
                                            Foreground="{StaticResource ErrorBrush}" Click="Stop_Click" Visibility="Collapsed"/>
                                    <Button x:Name="LogToggle" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Show log"
                                            Click="LogToggle_Click" Margin="0,0,16,0" Visibility="Collapsed"/>
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Effect><DropShadowEffect x:Name="StatusGlow" Color="#5CD6FF" BlurRadius="10" ShadowDepth="0" Opacity="0"/></Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="StatusText" Text="In game: Wreckreation › Multiplayer › Ad-hoc › Create Game or Join Game"
                                               Foreground="{StaticResource SubtleTextBrush}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBox x:Name="LogBox" Visibility="Collapsed" IsReadOnly="True" Height="96" Margin="0,10,0,0" FontFamily="{StaticResource CodeFont}"
                                         FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SubtleTextBrush}"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <!-- ======== HOST ======== -->
                            <DockPanel x:Name="HostPanel">
                                <Button x:Name="HostButton" DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Click="Host_Click" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="START HOSTING"/>
                                        <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="14" Margin="12,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="WHO'S RACING?" Style="{StaticResource Caption}"/>
                                    <UniformGrid Columns="3" Margin="-4,0,-4,16">
                                        <RadioButton x:Name="ReachLan" Style="{StaticResource ChoiceCard}" GroupName="reach" Margin="4,0" Checked="Reach_Changed">
                                            <StackPanel>
                                                <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource FrostBrush}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="Same Wi-Fi" FontWeight="SemiBold" Margin="0,6,0,1"/>
                                                <TextBlock Text="Friends nearby" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ReachInternet" Style="{StaticResource ChoiceCard}" GroupName="reach" Margin="4,0" Checked="Reach_Changed">
                                            <StackPanel>
                                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource FrostBrush}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="Internet" FontWeight="SemiBold" Margin="0,6,0,1"/>
                                                <TextBlock Text="Open port on router" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ReachServer" Style="{StaticResource ChoiceCard}" GroupName="reach" Margin="4,0" Checked="Reach_Changed">
                                            <StackPanel>
                                                <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource FrostBrush}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="Room server" FontWeight="SemiBold" Margin="0,6,0,1"/>
                                                <TextBlock Text="No port forwarding" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <!-- reach-specific settings -->
                                    <Grid x:Name="LanOptions" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="THIS PC ON YOUR NETWORK" Style="{StaticResource Caption}"/>
                                            <ComboBox x:Name="LanAddressBox" SelectionChanged="HostField_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PORT" Style="{StaticResource Caption}"/>
                                            <TextBox x:Name="PortBoxLan" Style="{StaticResource FrostBox}" TextChanged="Port_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="InternetOptions" Margin="0,0,0,16" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="PUBLIC ADDRESS" Style="{StaticResource Caption}"/>
                                            <TextBox x:Name="PublicAddressBox" Style="{StaticResource FrostBox}" Tag="e.g. 203.0.113.7" TextChanged="HostField_Changed"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IceButton}" Height="40" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                                Click="DetectPublic_Click" ToolTip="Ask api.ipify.org for this network's public address">
                                            <TextBlock x:Name="DetectText" Text="Detect"/>
                                        </Button>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="PORT (UDP)" Style="{StaticResource Caption}"/>
                                            <TextBox x:Name="PortBoxNet" Style="{StaticResource FrostBox}" TextChanged="Port_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="ServerOptions" Margin="0,0,0,16" Visibility="Collapsed">
                                        <TextBlock Text="ROOM SERVER" Style="{StaticResource Caption}"/>
                                        <TextBox x:Name="ServerBox" Style="{StaticResource FrostBox}" Tag="host:3478  (a psp_net_rendezvous server everyone can reach)"
                                                 TextChanged="HostField_Changed"/>
                                    </StackPanel>

                                    <!-- Join code -->
                                    <TextBlock Text="JOIN CODE — SEND THIS TO YOUR FRIENDS" Style="{StaticResource Caption}"/>
                                    <Border CornerRadius="14" Padding="16,14" BorderThickness="1" BorderBrush="#665CD6FF">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2A5CD6FF" Offset="0"/>
                                                <GradientStop Color="#0E3BF0C8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel>
                                            <TextBlock x:Name="JoinCodeText" FontFamily="{StaticResource CodeFont}" FontSize="16.5" FontWeight="SemiBold"
                                                       Foreground="#E9FBFF" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="JoinCodeNote" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,12"/>
                                            <WrapPanel>
                                                <Button Style="{StaticResource IceButton}" Click="CopyCode_Click" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="CopyCodeText" Text="Copy code"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource IceButton}" Click="CopyMessage_Click" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="CopyMessageText" Text="Copy invite message"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource IceButton}" Click="NewCode_Click" ToolTip="Make a new room code (old codes stop working)">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                        <TextBlock Text="New code"/>
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <DockPanel x:Name="FirewallRow" Margin="2,14,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="Firewall_Click" VerticalAlignment="Center">
                                            <TextBlock x:Name="FirewallText" Text="Allow through firewall"/>
                                        </Button>
                                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="FirewallHint" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- ======== JOIN ======== -->
                            <DockPanel x:Name="JoinPanel" Visibility="Collapsed">
                                <Button x:Name="JoinButton" DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Click="Join_Click" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="JOIN RACE"/>
                                        <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="14" Margin="12,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="Paste_Click" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Paste"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="JOIN CODE" Style="{StaticResource Caption}"/>
                                    </DockPanel>
                                    <TextBox x:Name="JoinCodeBox" Style="{StaticResource FrostBox}" Height="104" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalContentAlignment="Top" Padding="8,10" FontFamily="{StaticResource CodeFont}" FontSize="15"
                                             Tag="Paste the code or the whole invite message you got — e.g. 7F3K-…-QX@192.168.1.20:47900"
                                             TextChanged="JoinCode_Changed"/>

                                    <!-- parse result -->
                                    <Border x:Name="JoinResult" CornerRadius="12" Padding="14,12" Margin="0,14,0,0" Background="#14FFFFFF"
                                            BorderThickness="1" BorderBrush="{StaticResource GlassBorderBrush}">
                                        <DockPanel>
                                            <TextBlock x:Name="JoinResultIcon" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="18" VerticalAlignment="Top"
                                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,1,12,0"/>
                                            <StackPanel>
                                                <TextBlock x:Name="JoinResultTitle" Text="Waiting for a join code" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="JoinResultDetail" Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"
                                                           Text="The host gets it from their launcher (Windows) or the Multiplayer screen (Android)."/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <StackPanel x:Name="ManualAddress" Margin="0,14,0,0" Visibility="Collapsed">
                                        <TextBlock Text="HOST ADDRESS (THE CODE HAD NONE)" Style="{StaticResource Caption}"/>
                                        <TextBox x:Name="ManualAddressBox" Style="{StaticResource FrostBox}" Tag="ip:port, e.g. 192.168.1.20:47900  or  room=server:3478"
                                                 TextChanged="JoinCode_Changed"/>
                                    </StackPanel>

                                    <Border x:Name="ClipboardBanner" CornerRadius="12" Padding="14,10" Margin="0,14,0,0" Background="#1F3BF0C8"
                                            BorderThickness="1" BorderBrush="#553BF0C8" Visibility="Collapsed">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Use it" Foreground="{StaticResource AuroraBrush}"
                                                    FontWeight="SemiBold" Click="UseClipboard_Click"/>
                                            <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AuroraBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="A join code is on your clipboard." FontSize="12.5" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <Border CornerRadius="12" Padding="14,12" Margin="0,14,0,0" Background="#0CFFFFFF">
                                        <DockPanel>
                                            <TextBlock Text="&#xE8EA;" Style="{StaticResource Icon}" FontSize="18" VerticalAlignment="Top"
                                                       Foreground="{StaticResource AuroraBrush}" Margin="0,1,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Host on an Android phone?" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,3,0,0"
                                                           Text="On the phone: Multiplayer › Host a room › Share join code. Send it to this PC and paste it above — the phone and the PC must be on the same Wi-Fi unless you use a room server."/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Toast -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" CornerRadius="12"
                Background="#F00A1D33" BorderBrush="#775CD6FF" BorderThickness="1" Padding="18,10" Opacity="0" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
            <TextBlock x:Name="ToastText" FontSize="13"/>
        </Border>
    </Grid>
</Window>
