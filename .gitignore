# Build output
/out/
/build/
/Testing/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
CMakeUserPresets.json

# Build directories created outside /out/ (per-stage trees use names like b457_perf)
b*_perf/
cmake-build-*/

# Binary build artifacts, wherever they land
*.exe
*.dll
*.lib
*.obj
*.exp
*.iobj
*.ipdb
*.res
*.tlog
*.o
*.a
*.so
*.so.*
*.dylib
*.pch
*.idb
*.ipch

# Copyrighted game data.  Never publish: the PSP executable, its decrypted ELF
# and save data are the user's own dumped media, not part of this source tree.
PSP_DATA/
SAVEDATA/
*.ELF
*.elf
*.iso
*.cso
EBOOT*.BIN
BOOT.BIN
*.pbp
*.PBP
*.prx
*.PRX
*.at3
*.pmf

# User-owned game data and reverse-engineering workspace
/profiles/*/game/
/profiles/*/analysis/
/profiles/*/progress/
/profiles/*/captures/

# Generated scratch output (the checked-in profile corpus is not ignored)
*.generated
*.tmp
*.log
*.pdb
*.ilk
*.dmp
*.mdmp
*_crash.txt

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo
*.VC.db
*.VC.VC.opendb
/.cache/

# Local command-output scratch files
/dir
/gh

# Python
__pycache__/
*.pyc
